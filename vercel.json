{
  "version": 2,
  "builds": [
    {
      "src": "api/hello.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/hello.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/api/hello.ts"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "api/hello.ts": {
      "maxDuration": 30
    }
  }
}
